{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!src/strava-client"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "all",
      "react": "all",
      "drizzle": "all",
      "types": "all"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        },
        "noNonNullAssertion": "off",
        "useComponentExportOnlyModules": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noLeakedRender": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useNullishCoalescing": "error",
        "noDrizzleDeleteWithoutWhere": {
          "level": "error",
          "options": {
            "drizzleObjectName": [
              "db",
              "ctx.db"
            ]
          }
        },
        "noDrizzleUpdateWithoutWhere": {
          "level": "error",
          "options": {
            "drizzleObjectName": [
              "db",
              "ctx.db"
            ]
          }
        }
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/_components/Activity3DMap.tsx",
        "src/app/_components/DenseTerrainMesh.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ]
}
