{
  "name": "pathforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome lint --error-on-warnings && tsc --noEmit",
    "codegen": "npx @hey-api/openapi-ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev --turbo -p 9300",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@mapbox/polyline": "^1.2.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.8.0",
    "@trpc/react-query": "^11.8.0",
    "@trpc/server": "^11.8.0",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.179.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "delaunator": "^5.0.1",
    "drizzle-orm": "^0.45.2",
    "kdbush": "^4.0.2",
    "lucide-react": "^0.537.0",
    "next": "~16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "strava-v3": "^4.0.2",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/delaunator": "^5.0.0",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.148.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@10.9.2"
}
